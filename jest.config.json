{
  "testEnvironment": "jsdom",
  "setupFilesAfterEnv": ["<rootDir>/tests/setup.js"],
  "testMatch": ["**/tests/**/*.test.js"],
  "collectCoverageFrom": [
    "extension/background.js",
    "extension/logger.js"
  ],
  "coverageThreshold": {
    "global": {
      "branches": 70,
      "functions": 85,
      "lines": 80,
      "statements": 80
    },
    "extension/logger.js": {
      "branches": 75,
      "functions": 95,
      "lines": 90,
      "statements": 90
    }
  }
}
